datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// USERS & AUTHENTICATION

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServiceType {
  SERVICE
  SCHEME
}

// 2. SERVICE MODEL
model Service {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  slug        String      @unique
  title       String
  description String
  category    String      @default("General")
  price       String?
  features    String[]
  icon        String?     @default("Briefcase")
  image       String?
  status      String      @default("active")
  type        ServiceType @default(SERVICE) // 
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ServiceDetail {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  title           String
  titleGradient   String?
  categoryBadge   String   @default("Complete Guide")
  heroDescription String
  heroBgImage     String   @default("/assets/images/br2.webp")

  introHeading    String   @default("Introduction")
  introLead       String
  introBody       String

  benefits        BenefitItem[]

  eligibility     String[]
  documents       String[]

  processSteps    ProcessStep[]

  faqs            FAQItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Composite/Embedded Types for MongoDB

type BenefitItem {
  title       String
  description String
  iconName    String?
}

type ProcessStep {
  stepNumber  Int
  title       String
  description String
  isFinal     Boolean @default(false)
}

type FAQItem {
  question String
  answer   String
}

// FEATURES MODEL

model Feature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  image       String
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// CONTACT MODEL

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  // Contact form fields
  name      String?
  email     String?
  phone     String?
  company   String?
  message   String?

  // Schedule a Call fields
  scheduleDate  DateTime?
  scheduleTime  String?
  scheduleNotes String?
  scheduleGuests String[] @default([])

  createdAt DateTime @default(now())
}
